<Window x:Class="WClean.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WClean.App.ViewModels"
        xmlns:views="clr-namespace:WClean.App.Views"
        Title="W Clean" Width="1220" Height="800" MinWidth="1000" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        TextElement.Foreground="{DynamicResource TextBrush}"
        FontSize="13">

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:StartupViewModel}"><views:StartupView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:JunkViewModel}"><views:JunkView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:RegistryViewModel}"><views:RegistryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LargeFileViewModel}"><views:LargeFileView /></DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="276" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= sidebar ================= -->
        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <Grid Margin="16,22,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Orientation="Horizontal" Margin="8,0,0,26">
                    <Grid Width="42" Height="42">
                        <Border CornerRadius="12" Background="{DynamicResource LogoBrush}" />
                        <TextBlock Style="{StaticResource Icon}" FontSize="22" Foreground="White" Text="&#xE945;" />
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold" Text="W Clean" />
                        <TextBlock Style="{StaticResource Small}" Text="PC 정리 도구" />
                    </StackPanel>
                </StackPanel>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding Items}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <RadioButton GroupName="nav" Style="{StaticResource NavItem}"
                                         Content="{Binding Page.Title}" Tag="{Binding Page.Glyph}"
                                         IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Grid.Row="2">
                    <Border Style="{StaticResource Card}" Padding="14,12" CornerRadius="10">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0"
                                           Foreground="{DynamicResource AccentBrush}" Text="&#xEA18;" />
                                <TextBlock Style="{StaticResource Small}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           Text="{Binding AdminText}" />
                            </StackPanel>
                            <Button Style="{StaticResource BtnPrimary}" Tag="&#xE7EF;" Content="관리자 권한으로 다시 시작"
                                    Margin="0,10,0,0" Padding="10,8" FontSize="12"
                                    Command="{Binding RestartAsAdminCommand}"
                                    Visibility="{Binding NotAdmin, Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </Border>

                    <Grid Margin="6,16,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="15" Margin="0,0,8,0"
                                       Foreground="{DynamicResource SubTextBrush}" Text="&#xE708;" />
                            <TextBlock VerticalAlignment="Center" Text="다크 모드" Foreground="{DynamicResource SubTextBrush}" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right"
                                      IsChecked="{Binding IsDark, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Small}" Margin="6,12,0,0" Text="{Binding Version}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= page ================= -->
        <ContentControl Grid.Column="1" Content="{Binding Selected.Page}" />
    </Grid>
</Window>
