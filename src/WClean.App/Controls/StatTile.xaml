<UserControl x:Class="WClean.App.Controls.StatTile"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root">
    <Border Style="{StaticResource Card}" Padding="18,14">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="44" Height="44" Margin="0,0,14,0">
                <Border CornerRadius="12" Background="{Binding Tone, ElementName=Root}" Opacity="0.16" />
                <TextBlock Style="{StaticResource Icon}" FontSize="21" Text="{Binding Glyph, ElementName=Root}"
                           Foreground="{Binding Tone, ElementName=Root}" />
            </Grid>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Small}" Text="{Binding Label, ElementName=Root}" />
                <TextBlock FontSize="22" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                           Foreground="{DynamicResource TextBrush}" Text="{Binding Value, ElementName=Root}" />
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
