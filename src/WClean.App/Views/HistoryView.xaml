<UserControl x:Class="WClean.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WClean.App.Controls">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding Description}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,22,0,0">
            <c:StatTile Margin="0,0,12,0" Label="지금까지 확보한 용량" Value="{Binding TotalFreed}" Glyph="&#xE73A;" Tone="{DynamicResource SuccessBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="정리 횟수" Value="{Binding Runs}" Glyph="&#xE81C;" Tone="{DynamicResource AccentBrush}" />
            <c:StatTile Label="마지막 정리" Value="{Binding Last}" Glyph="&#xE787;" Tone="{DynamicResource WarnBrush}" />
        </UniformGrid>

        <UniformGrid Grid.Row="2" Rows="1" Margin="0,16,0,12">
            <Border Style="{StaticResource Card}" Padding="18,14" Margin="0,0,12,0">
                <StackPanel>
                    <Grid>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" Text="&#xE916;" />
                            <TextBlock FontWeight="SemiBold" FontSize="14" Text="자동 정리 예약" VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleButton Style="{StaticResource Switch}" HorizontalAlignment="Right" IsChecked="{Binding ScheduleOn, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,10" TextWrapping="Wrap"
                               Text="켜 두면 정해진 시간에 쓰레기파일(기본 선택 항목, 휴지통 제외)을 자동으로 정리하고 알림을 보여 줍니다. 관리자 권한이 필요합니다." />
                    <ComboBox Height="36" VerticalContentAlignment="Center" ItemsSource="{Binding Frequencies}"
                              SelectedItem="{Binding Frequency}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" Text="&#xE777;" />
                        <TextBlock FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center">
                            <Run Text="업데이트 · 현재 v" /><Run Text="{Binding CurrentVersion, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                    <TextBlock Style="{StaticResource Small}" Margin="0,8,0,10" TextWrapping="Wrap"
                               Text="GitHub 릴리즈에서 새 버전이 있는지만 확인합니다. 자동으로 내려받거나 설치하지 않습니다." />
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource Btn}" Tag="&#xE72C;" Content="업데이트 확인" Margin="0,0,8,0" Command="{Binding CheckUpdateCommand}" />
                        <Button Style="{StaticResource BtnPrimary}" Tag="&#xE896;" Content="받으러 가기" Margin="0,0,12,0" Command="{Binding OpenUpdateCommand}"
                                Visibility="{Binding HasUpdate, Converter={StaticResource BoolToVis}}" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Small}" Text="{Binding UpdateText}" />
                    </StackPanel>
                    <CheckBox Margin="0,10,0,0" Content="시작할 때 자동으로 확인" IsChecked="{Binding AutoCheck}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,4,10,10">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding Entries}"
                          IsReadOnly="True" SelectionMode="Single" RowHeight="46">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="시각" Width="170">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" Text="{Binding TimeText}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="작업" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding Action}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="확보한 용량" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" Text="{Binding BytesText}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="항목 수" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" Text="{Binding Count, StringFormat=N0}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="아직 정리 기록이 없습니다">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=Grid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="False">
            <Button DockPanel.Dock="Right" Style="{StaticResource Btn}" Margin="0" Padding="12,6" FontSize="12" Content="기록 지우기" Command="{Binding ClearCommand}" />
            <TextBlock Style="{StaticResource Small}" Text="{Binding Status}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
