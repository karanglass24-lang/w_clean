<UserControl x:Class="WClean.App.Views.DuplicateView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WClean.App.Controls">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding Description}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,22,0,0">
            <c:StatTile Margin="0,0,12,0" Label="중복 묶음" Value="{Binding GroupsText}" Glyph="&#xE8C8;" Tone="{DynamicResource AccentBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="줄일 수 있는 용량" Value="{Binding WastedText}" Glyph="&#xEDA2;" Tone="{DynamicResource WarnBrush}" />
            <c:StatTile Label="선택한 용량" Value="{Binding SelectedText}" Glyph="&#xE73A;" Tone="{DynamicResource SuccessBrush}" />
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Height="38" IsEditable="True" VerticalContentAlignment="Center" Margin="0,0,8,0"
                          ItemsSource="{Binding Locations}"
                          Text="{Binding SearchPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Style="{StaticResource Btn}" Tag="&#xE838;" Content="폴더 선택" Command="{Binding BrowseCommand}" />
                <ComboBox Grid.Column="2" Width="130" Height="38" Margin="0,0,8,0" VerticalContentAlignment="Center"
                          ItemsSource="{Binding MinSizes}" DisplayMemberPath="Text" SelectedItem="{Binding SelectedMin}" />
                <Button Grid.Column="3" Style="{StaticResource BtnPrimary}" Tag="&#xE721;" Content="검색" Command="{Binding ScanCommand}" />
                <Button Grid.Column="4" Style="{StaticResource Btn}" Tag="&#xE711;" Content="중지" Margin="0" Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,12">
            <Button Style="{StaticResource Btn}" Tag="&#xE73E;" Content="중복 자동 선택" Command="{Binding AutoSelectCommand}"
                    ToolTip="각 묶음에서 가장 오래된 파일 하나만 남기고 나머지를 선택합니다" />
            <Button Style="{StaticResource Btn}" Content="선택 해제" Command="{Binding ClearSelectCommand}" />
            <Button Style="{StaticResource BtnDanger}" Tag="&#xE74D;" Content="선택 파일 삭제" Command="{Binding DeleteCommand}" />
            <Button Style="{StaticResource Btn}" Tag="&#xE838;" Content="파일 위치" Command="{Binding OpenLocationCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=Grid}" />
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10,4,10,10">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding Results}"
                          IsReadOnly="True" SelectionMode="Single" RowHeight="52">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="삭제" Width="64">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" MinWidth="0" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="묶음" Width="70">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Background="{DynamicResource AccentSoftBrush}" HorizontalAlignment="Left">
                                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}">
                                            <Run Text="#" /><Run Text="{Binding Group, Mode=OneWay}" />
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="파일" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                                        <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Small}" Text="{Binding Directory}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="크기" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Cell}" Text="{Binding SizeText}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="수정한 날짜" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Cell}" Text="{Binding Modified, StringFormat=yyyy-MM-dd HH:mm}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=Grid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource TrackBrush}" Text="&#xE8C8;" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" HorizontalAlignment="Center" Text="폴더를 고르고 ‘검색’을 눌러 같은 파일을 찾아보세요" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="True">
            <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Small}" Text="{Binding Status}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
