<UserControl x:Class="WClean.App.Views.BackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WClean.App.Controls">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding Description}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,22,0,0">
            <c:StatTile Margin="0,0,12,0" Label="전체 백업" Value="{Binding Total}" Glyph="&#xE777;" Tone="{DynamicResource AccentBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="레지스트리" Value="{Binding RegCount}" Glyph="&#xE713;" Tone="{DynamicResource WarnBrush}" />
            <c:StatTile Label="작업 스케줄러" Value="{Binding TaskCount}" Glyph="&#xE916;" Tone="{DynamicResource SuccessBrush}" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,12">
            <Button Style="{StaticResource BtnPrimary}" Tag="&#xE777;" Content="선택 항목 복원" Command="{Binding RestoreCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
            <Button Style="{StaticResource BtnDanger}" Tag="&#xE74D;" Content="백업 삭제" Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
            <Button Style="{StaticResource Btn}" Tag="&#xE72C;" Content="새로고침" Command="{Binding RefreshCommand}" />
            <Button Style="{StaticResource Btn}" Tag="&#xE838;" Content="백업 폴더 열기" Command="{Binding OpenFolderCommand}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,4,10,10">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding Items}"
                          IsReadOnly="True" SelectionMode="Extended">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="백업" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34" Margin="0,0,12,0">
                                            <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" />
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" ToolTip="{Binding Path}">
                                            <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding Label}" />
                                            <TextBlock Style="{StaticResource Small}" Text="{Binding KindText}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="저장한 시각" Width="180">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" Text="{Binding TimeText}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="크기" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" Text="{Binding SizeText}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="저장된 백업이 없습니다">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=Grid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" Style="{StaticResource Small}" Text="{Binding Status}" />
    </Grid>
</UserControl>
