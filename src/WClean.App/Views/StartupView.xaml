<UserControl x:Class="WClean.App.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WClean.App.Controls">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding Description}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,22,0,0">
            <c:StatTile Margin="0,0,12,0" Label="전체 항목" Value="{Binding Total}" Glyph="&#xE71D;" Tone="{DynamicResource AccentBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="시작 시 실행" Value="{Binding EnabledCount}" Glyph="&#xE73E;" Tone="{DynamicResource SuccessBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="사용 안 함" Value="{Binding DisabledCount}" Glyph="&#xE7E8;" Tone="{DynamicResource SubTextBrush}" />
            <c:StatTile Label="파일 없음" Value="{Binding MissingCount}" Glyph="&#xE7BA;" Tone="{DynamicResource DangerBrush}" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,12">
            <Button Style="{StaticResource Btn}" Tag="&#xE72C;" Content="새로고침" Command="{Binding RefreshCommand}" />
            <Button Style="{StaticResource Btn}" Tag="&#xE7E8;" Content="선택 항목 끄기" Command="{Binding DisableCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
            <Button Style="{StaticResource Btn}" Tag="&#xE838;" Content="파일 위치" Command="{Binding OpenLocationCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
            <Button Style="{StaticResource BtnDanger}" Tag="&#xE74D;" Content="선택 항목 삭제" Command="{Binding DeleteCommand}"
                    CommandParameter="{Binding SelectedItems, ElementName=Grid}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,4,10,10">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding Entries}"
                          IsReadOnly="True" SelectionMode="Extended">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow" BasedOn="{StaticResource GridRow}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsEnabled}" Value="False">
                                    <Setter Property="Opacity" Value="0.55" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="이름" Width="300">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34" Margin="0,0,12,0">
                                            <Border CornerRadius="9" Background="{DynamicResource AccentSoftBrush}" />
                                            <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding Name}" ToolTip="{Binding Name}" />
                                            <TextBlock Style="{StaticResource Small}" Text="{Binding Source}" />
                                        </StackPanel>
                                    </Grid>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="사용" Width="80">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource Switch}" IsChecked="{Binding IsEnabled, Mode=OneWay}"
                                                  Command="{Binding DataContext.ToggleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                  CommandParameter="{Binding}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="실행 명령" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Cell}" Text="{Binding Command}" ToolTip="{Binding Command}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTemplateColumn Header="상태" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource Chip}" Background="{DynamicResource DangerSoftBrush}"
                                            Visibility="{Binding TargetMissing, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="파일 없음" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource DangerBrush}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="시작프로그램을 불러오는 중…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=Grid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Small}" Text="{Binding Status}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
