<UserControl x:Class="WClean.App.Views.ServicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WClean.App.Controls">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" TextWrapping="Wrap" Text="{Binding Description}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,22,0,0">
            <c:StatTile Margin="0,0,12,0" Label="자동 시작 (Microsoft 제외)" Value="{Binding AutoCount}" Glyph="&#xE90F;" Tone="{DynamicResource AccentBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="실행 중" Value="{Binding RunningCount}" Glyph="&#xE768;" Tone="{DynamicResource SuccessBrush}" />
            <c:StatTile Label="사용 안 함" Value="{Binding DisabledCount}" Glyph="&#xE7E8;" Tone="{DynamicResource SubTextBrush}" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,12">
            <Button Style="{StaticResource Btn}" Tag="&#xE72C;" Content="새로고침" Command="{Binding RefreshCommand}" />
            <TextBox Width="240" Height="38" Margin="0,0,12,0" VerticalContentAlignment="Center"
                     Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" ToolTip="서비스 이름으로 검색" />
            <CheckBox VerticalAlignment="Center" Content="Microsoft 서비스도 표시" IsChecked="{Binding ShowMicrosoft}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="10,4,10,10">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding Services}"
                          IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="서비스" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Description}">
                                        <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding DisplayName}" />
                                        <TextBlock Style="{StaticResource Small}">
                                            <Run Text="{Binding Name, Mode=OneWay}" /><Run Text="  ·  " /><Run Text="{Binding Company, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="상태" Width="90">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" Text="{Binding StateText}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="시작 유형" Width="110">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate><TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding ModeText}" /></DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="시작 유형 변경" Width="230">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" Content="자동"
                                                Command="{Binding DataContext.AutoCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" Content="수동"
                                                Command="{Binding DataContext.ManualCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource BtnDanger}" Padding="10,5" Margin="0" FontSize="12" Content="사용 안 함"
                                                Command="{Binding DataContext.DisableCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="" Width="130">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource Btn}" Padding="10,5" Margin="0,0,6,0" FontSize="12" Content="시작"
                                                Command="{Binding DataContext.StartCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                        <Button Style="{StaticResource Btn}" Padding="10,5" Margin="0" FontSize="12" Content="중지"
                                                Command="{Binding DataContext.StopCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}" CommandParameter="{Binding}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock Text="서비스를 불러오는 중…">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource EmptyHint}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=Grid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Small}" Text="{Binding Status}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
