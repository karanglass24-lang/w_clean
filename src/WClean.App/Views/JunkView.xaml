<UserControl x:Class="WClean.App.Views.JunkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WClean.App.Controls">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding Description}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,22,0,0">
            <c:StatTile Margin="0,0,12,0" Label="정리 가능한 용량" Value="{Binding TotalText}" Glyph="&#xE74D;" Tone="{DynamicResource AccentBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="선택한 용량" Value="{Binding SelectedText}" Glyph="&#xE73A;" Tone="{DynamicResource SuccessBrush}" />
            <c:StatTile Label="발견된 항목" Value="{Binding FoundText}" Glyph="&#xE721;" Tone="{DynamicResource WarnBrush}" />
        </UniformGrid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,20,0,12">
            <Button Style="{StaticResource BtnPrimary}" Tag="&#xE721;" Content="검사" Command="{Binding ScanCommand}" />
            <Button Style="{StaticResource BtnDanger}" Tag="&#xE74D;" Content="선택 항목 정리" Command="{Binding CleanCommand}" />
            <Button Style="{StaticResource Btn}" Content="모두 선택" Command="{Binding SelectAllCommand}" />
            <Button Style="{StaticResource Btn}" Content="모두 해제" Command="{Binding SelectNoneCommand}" />
        </StackPanel>

        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Row" CornerRadius="8" Padding="10,10" Margin="0,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="230" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox VerticalAlignment="Center" MinWidth="0" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
                                    <Grid Grid.Column="1" Width="38" Height="38" Margin="4,0,14,0">
                                        <Border CornerRadius="10" Background="{DynamicResource AccentSoftBrush}" />
                                        <TextBlock Style="{StaticResource Icon}" FontSize="18" Text="{Binding Glyph}" Foreground="{DynamicResource AccentBrush}" />
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource TextBrush}" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Small}" Text="{Binding Description}" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="12,0,6,0">
                                        <TextBlock HorizontalAlignment="Right" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="{Binding SizeText}" />
                                        <ProgressBar Style="{StaticResource Thin}" Margin="0,6,0,0" Value="{Binding Ratio}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Row" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource RowHoverBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <DockPanel Grid.Row="4" Margin="0,12,0,0" LastChildFill="True">
            <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Small}" Text="{Binding Status}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
