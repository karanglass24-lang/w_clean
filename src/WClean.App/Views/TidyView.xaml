<UserControl x:Class="WClean.App.Views.TidyView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:WClean.App.Controls">
    <Grid Margin="32,28,32,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource Sub}" Margin="0,4,0,0" Text="{Binding Description}" />
        </StackPanel>

        <UniformGrid Grid.Row="1" Rows="1" Margin="0,22,0,0">
            <c:StatTile Margin="0,0,12,0" Label="깨진 바로가기" Value="{Binding ShortcutCount}" Glyph="&#xE71B;" Tone="{DynamicResource DangerBrush}" />
            <c:StatTile Margin="0,0,12,0" Label="빈 폴더" Value="{Binding FolderCount}" Glyph="&#xE8B7;" Tone="{DynamicResource WarnBrush}" />
            <c:StatTile Label="선택됨" Value="{Binding CheckedCount}" Glyph="&#xE73A;" Tone="{DynamicResource SuccessBrush}" />
        </UniformGrid>

        <Border Grid.Row="2" Style="{StaticResource Card}" Padding="12" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox Height="38" IsEditable="True" VerticalContentAlignment="Center" Margin="0,0,8,0"
                          ItemsSource="{Binding Locations}" ToolTip="빈 폴더를 찾을 위치"
                          Text="{Binding SearchPath, UpdateSourceTrigger=PropertyChanged}" />
                <Button Grid.Column="1" Style="{StaticResource Btn}" Tag="&#xE838;" Content="폴더 선택" Command="{Binding BrowseCommand}" />
                <CheckBox Grid.Column="2" VerticalAlignment="Center" Margin="4,0,12,0" Content="깨진 바로가기" IsChecked="{Binding ScanShortcuts}"
                          ToolTip="바탕화면과 시작 메뉴를 검사합니다" />
                <CheckBox Grid.Column="3" VerticalAlignment="Center" Margin="0,0,12,0" Content="빈 폴더" IsChecked="{Binding ScanFolders}" />
                <Button Grid.Column="4" Style="{StaticResource BtnPrimary}" Tag="&#xE721;" Content="검사" Command="{Binding ScanCommand}" />
                <Button Grid.Column="5" Style="{StaticResource Btn}" Tag="&#xE711;" Content="중지" Margin="0" Command="{Binding CancelCommand}" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,12">
            <Button Style="{StaticResource BtnDanger}" Tag="&#xE74D;" Content="선택 항목 정리" Command="{Binding DeleteCommand}" />
            <Button Style="{StaticResource Btn}" Content="모두 선택" Command="{Binding SelectAllCommand}" />
            <Button Style="{StaticResource Btn}" Content="모두 해제" Command="{Binding SelectNoneCommand}" />
            <Button Style="{StaticResource Btn}" Tag="&#xE838;" Content="위치 열기" Command="{Binding OpenLocationCommand}"
                    CommandParameter="{Binding SelectedItem, ElementName=Grid}" />
        </StackPanel>

        <Border Grid.Row="4" Style="{StaticResource Card}" Padding="10,4,10,10">
            <Grid>
                <DataGrid x:Name="Grid" Style="{StaticResource Grid}" ItemsSource="{Binding Items}"
                          IsReadOnly="True" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="" Width="50">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox HorizontalAlignment="Center" MinWidth="0" IsChecked="{Binding IsChecked, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="종류" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource Icon}" Text="{Binding Glyph}" Margin="0,0,10,0" Foreground="{DynamicResource AccentBrush}" />
                                        <TextBlock Style="{StaticResource Cell}" Text="{Binding KindText}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="이름" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                                        <TextBlock Style="{StaticResource Cell}" FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Style="{StaticResource Small}" Text="{Binding Directory}" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Header="내용" Width="280">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Style="{StaticResource Cell}" Text="{Binding Detail}" ToolTip="{Binding Detail}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Items.Count, ElementName=Grid}" Value="0">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>
                    <TextBlock Style="{StaticResource Icon}" FontSize="40" Foreground="{DynamicResource TrackBrush}" Text="&#xE71B;" />
                    <TextBlock Style="{StaticResource Sub}" Margin="0,10,0,0" HorizontalAlignment="Center" Text="‘검사’를 눌러 깨진 바로가기와 빈 폴더를 찾아보세요" />
                </StackPanel>
            </Grid>
        </Border>

        <DockPanel Grid.Row="5" Margin="0,12,0,0" LastChildFill="True">
            <ProgressBar DockPanel.Dock="Right" Width="140" Height="4" IsIndeterminate="True" VerticalAlignment="Center"
                         Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
            <TextBlock Style="{StaticResource Small}" Text="{Binding Status}" VerticalAlignment="Center" />
        </DockPanel>
    </Grid>
</UserControl>
