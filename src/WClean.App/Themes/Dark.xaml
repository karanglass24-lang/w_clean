<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="BgBrush" Color="#14151A" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#1E2027" />
    <SolidColorBrush x:Key="LineBrush" Color="#2E313D" />
    <SolidColorBrush x:Key="TextBrush" Color="#ECEEF5" />
    <SolidColorBrush x:Key="SubTextBrush" Color="#9AA0B2" />
    <SolidColorBrush x:Key="AccentBrush" Color="#6B83F5" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#262C4D" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="DangerBrush" Color="#E5484D" />
    <SolidColorBrush x:Key="DangerSoftBrush" Color="#3A2226" />
    <SolidColorBrush x:Key="SuccessBrush" Color="#4CC38A" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1E3329" />
    <SolidColorBrush x:Key="WarnBrush" Color="#F2A93B" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#3B2E17" />
    <SolidColorBrush x:Key="TrackBrush" Color="#2E313D" />
    <SolidColorBrush x:Key="RowHoverBrush" Color="#252833" />
    <SolidColorBrush x:Key="RowSelectedBrush" Color="#262C4D" />
    <SolidColorBrush x:Key="HoverOverlay" Color="#1FFFFFFF" />
    <LinearGradientBrush x:Key="LogoBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#6F8BFF" Offset="0" />
        <GradientStop Color="#8A5CF6" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>
